# ─── ENVIRONMENT ──────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. `.env*` is gitignored; this file is the only
# one that is committed, and it must never contain a real value.
#
#   cp .env.example .env.local
#
# Full guide: docs/ENV_SETUP.md
#
# Marked REQUIRED, the process refuses to start without it. `lib/env.ts` throws
# rather than falling back, because four different hardcoded fallback JWT secrets
# once meant a missing variable left some routes signing tokens with a string
# published in this repository.


# ─── SECRETS (REQUIRED) ───────────────────────────────────────────────────────

# Signs candidate and staff session cookies. Any length; use 32+ random bytes.
#   openssl rand -base64 32
JWT_SECRET=

# Pepper mixed into the device-key hash before it is stored, so a database dump
# does not hand over the keys that would let someone forge a device binding.
# Must be different from JWT_SECRET.   openssl rand -base64 32
DEVICE_PEPPER=

# Shared secret with the WordPress registration form. Sent as `x-api-key` on
# POST /api/register.
WP_TO_APP_SECRET=


# ─── DATABASE (REQUIRED) ──────────────────────────────────────────────────────

# PostgreSQL connection string. Neon serverless works; any Postgres does.
#
# Use `sslmode=verify-full` explicitly. The `pg` driver currently treats
# `require` and `prefer` as aliases of `verify-full` and warns that this changes
# in the next major version — writing what you mean now avoids a surprise upgrade
# that either tightens the connection or drops the check.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Set to "true" for a plaintext local database. Anything else, or unset, means
# TLS to the server.
# DATABASE_SSL=false

# Connection pool ceiling per serverless instance. Serverless means many
# instances; this multiplies. Ten is deliberate — see docs/ENV_SETUP.md.
# DB_POOL_MAX=10

# Log every SQL statement. Development only.
# SQL_LOG=true


# ─── REDIS (OPTIONAL) ─────────────────────────────────────────────────────────
# Without these the app still runs. Locks and rate limits fall back to a
# single-process path, which is correct on one instance and not correct on
# several — see docs/ENV_SETUP.md before running more than one.

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ─── THE ROUND ────────────────────────────────────────────────────────────────
# Every number the README quotes is read from config/rules.ts, which reads these.
# Defaults are the values from the last event; change them per round.

# Scholarships available across all courses. The per-course cap is this divided
# by the number of courses in config/course-matrix.ts, rounded down.
# TOTAL_SLOTS=546

# How many candidates reach the theory paper. Ranked by score, then finish time.
# QUALIFIED_POOL_SIZE=910

# Hard stop on attendance. Check-in refuses beyond this.
# VENUE_CAPACITY=3500

# Section lengths, in minutes. These are enforced from database timestamps, not
# from a browser timer.
# OBJECTIVE_TTL_MINUTES=30
# THEORY_TTL_MINUTES=45

# Minimum words per theory answer to be gradeable.
# THEORY_MIN_WORDS=50

# Objective pass mark, as a percentage.
#
# NEXT_PUBLIC_ is a separate variable on purpose: the candidate's rules page has
# to state the number the server enforces, and a client bundle cannot read a
# server variable. Set BOTH to the same value, or the rules page will quote a
# number that is not the one being applied.
# OBJECTIVE_PASS_MARK=80
# NEXT_PUBLIC_OBJECTIVE_PASS_MARK=80

# The cohort year, used in copy and on registrants.
# CURRENT_COHORT=2026

# Ticket code format: prefix + "-" + 8 hex characters. Change this only if you
# are issuing a new format — existing printed tickets stop validating.
# TICKET_PREFIX=TS26
# TICKET_BODY_LENGTH=8


# ─── IDENTITY (OPTIONAL) ──────────────────────────────────────────────────────
# All have working defaults. Set them to describe your event; the repository
# stays publishable and a new cohort is a .env change rather than a code change.

# EVENT_NAME=Tech Scholarship Programme
# EVENT_SHORT_NAME=Scholarship Programme
# EVENT_ORGANISATION=Programme Office
# EVENT_TAGLINE=A day of assessments, scholarships and careers.
# EVENT_DATE=
# EVENT_VENUE=
# EVENT_ADDRESS=
# EVENT_CONTACT_EMAIL=support@example.com

# Where the portal is deployed. Used in links and QR payloads.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social links for the confirmation page. Unset means the icons are not shown,
# rather than linking somewhere unconfigured.
# SOCIAL_INSTAGRAM=
# SOCIAL_FACEBOOK=
# SOCIAL_LINKEDIN=
# SOCIAL_X=

# Palette for the confirmation page, the email and the QR code.
# BRAND_INK=#141210
# BRAND_ACCENT=#B45309
# BRAND_ACCENT_SOFT=#FEF3C7
# BRAND_PAPER=#FFFFFF
# BRAND_MUTED=#78716C
# BRAND_LINE=#E7E5E4


# ─── EMAIL (OPTIONAL) ─────────────────────────────────────────────────────────
# Without a key, registration still succeeds and the ticket is logged instead of
# sent. See docs/ENV_SETUP.md — a candidate who never receives their ticket is a
# support queue, not a graceful degradation.

# RESEND_API_KEY=
# MAIL_FROM=Programme Office <no-reply@example.com>


# ─── WORDPRESS FORM FIELDS (OPTIONAL) ─────────────────────────────────────────
# The CMS's field names, not ours. Rename a field in WordPress and set it here
# rather than changing code. Gravity Forms keys are accepted as fallbacks.

# WP_API_KEY=
# WP_FORM_BLOB_FIELD=event-registration


# ─── PUBLIC REGISTRATION FORM (REQUIRED IN PRODUCTION) ────────────────────────
# The in-app application form at /register, which posts to /api/apply.
#
# That endpoint is PUBLIC — anyone on the internet can reach it, which is the
# whole point of it. So unlike /api/register there is no shared secret to gate
# it. Turnstile is what stops a script filling the admissions queue with
# thousands of fake applicants, every one of which becomes a real row that then
# counts toward the ranking and the per-course seat totals.
#
# Get both keys from Cloudflare → Turnstile → Add widget. The site key is public
# by design; the secret must never reach the browser.
#
# Unset in development, the form still works and the server warns loudly.
# Unset in PRODUCTION, /api/apply refuses every request rather than quietly
# serving an unprotected public write endpoint.
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=


# ─── DIAGNOSTICS ──────────────────────────────────────────────────────────────
# error | warn | info | debug
# LOG_LEVEL=info
# DEBUG=false
